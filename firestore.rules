rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function hasValidServiceFields() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 80
        && request.resource.data.category != '__proto__'
        && request.resource.data.category != 'constructor'
        && request.resource.data.category != 'prototype'
        && request.resource.data.priceFrom is int
        && request.resource.data.priceFrom >= 0
        && request.resource.data.priceFrom <= 10000;
    }

    function hasValidPromotionDates() {
      return request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && request.resource.data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.endDate.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function hasValidPromotionReminderSignupFields() {
      return request.resource.data.keys().hasOnly(['firstName', 'lastName', 'email', 'phone', 'smsConsent', 'consentVersion', 'optInSource', 'createdAt'])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 160
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 32
        && request.resource.data.phone.matches('^\\+?[0-9\\s().-]{7,}$')
        && request.resource.data.smsConsent == true
        && request.resource.data.consentVersion == 'sms-promotion-reminders-2026-10-09'
        && request.resource.data.optInSource == 'website-promotion-reminders-form'
        && request.resource.data.createdAt == request.time;
    }

    match /offers/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{document=**} {
      allow read: if true;
      allow create, update: if isAdmin() && hasValidServiceFields();
      allow delete: if isAdmin();
    }

    match /galleryImages/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogPosts/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promotions/{document=**} {
      allow read: if true;
      allow create, update: if isAdmin() && hasValidPromotionDates();
      allow delete: if isAdmin();
    }

    match /promotionReminderSignups/{document=**} {
      allow read, update, delete: if isAdmin();
      allow create: if hasValidPromotionReminderSignupFields();
    }

    function hasValidLovelyPromotionSignupFields() {
      return request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'emailConsent', 'smsConsent', 'consentText', 'smsConsentText', 'consentVersion', 'salonname', 'source', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 32
        && request.resource.data.phone.matches('^\\+?[0-9\\s().-]{7,}$')
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 160
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.emailConsent == true
        && request.resource.data.smsConsent is bool
        && request.resource.data.consentText is string
        && request.resource.data.consentText.size() <= 400
        && request.resource.data.smsConsentText is string
        && request.resource.data.smsConsentText.size() <= 400
        && request.resource.data.consentVersion is string
        && request.resource.data.consentVersion.size() <= 40
        && request.resource.data.salonname == 'Lovely Nail & Spa'
        && request.resource.data.source == 'nailslovely.com'
        && request.resource.data.createdAt == request.time;
    }

    // Lovely Nail & Spa keeps its own live menu and promotion-signup list in this
    // (Casabella's) Firestore project, written directly from the Lovely site's
    // browser code with no Firebase Auth. Both collections had no rules at all,
    // which meant Firestore default-denied them: the live menu silently fell back
    // to its bundled static copy, and every signup submission failed with a
    // permission error. These two rules are the fix.
    match /lovelyNailServices/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /lovelyNailPromotionList/{document=**} {
      allow read, update, delete: if isAdmin();
      allow create: if hasValidLovelyPromotionSignupFields();
    }

    // Chat messages are only ever read/written server-side (via the Base44-hosted
    // chat function using a service account, which bypasses these rules entirely).
    // No client ever needs direct access, so lock it down explicitly rather than
    // relying on the implicit default-deny.
    match /lovelyCustomerChats/{document=**} {
      allow read, write: if isAdmin();
    }

    function hasValidBookingRequestFields() {
      return request.resource.data.keys().hasOnly(['fullName', 'phone', 'email', 'preferredDate', 'preferredTime', 'serviceCategory', 'notes', 'createdAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 32
        && request.resource.data.phone.matches('^\\+?[0-9\\s().-]{7,}$')
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 160
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.preferredDate is string
        && request.resource.data.preferredDate.size() <= 40
        && request.resource.data.preferredTime is string
        && request.resource.data.preferredTime.size() <= 40
        && request.resource.data.serviceCategory is string
        && request.resource.data.serviceCategory.size() <= 120
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && request.resource.data.createdAt == request.time;
    }

    function hasValidContactMessageFields() {
      return request.resource.data.keys().hasOnly(['fullName', 'phone', 'email', 'message', 'createdAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 32
        && request.resource.data.phone.matches('^\\+?[0-9\\s().-]{7,}$')
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 160
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt == request.time;
    }

    // Inbound appointment requests and contact messages from the public Booking/Contact forms.
    // Anyone can submit one (that's the point of the form); only the salon's admin can read or manage them.
    match /bookingRequests/{document=**} {
      allow read, update, delete: if isAdmin();
      allow create: if hasValidBookingRequestFields();
    }

    match /contactMessages/{document=**} {
      allow read, update, delete: if isAdmin();
      allow create: if hasValidContactMessageFields();
    }

    // One doc per salon (id = salon slug) with its posted hours. Both salon websites read this
    // publicly; only the admin (via NailsSalonManagement) writes it.
    match /locationHours/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
